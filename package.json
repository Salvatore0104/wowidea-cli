{
  "name": "@easyai/cli",
  "version": "0.8.0",
  "description": "CLI for images, video, layers, and batch jobs on wowidea.top",
  "type": "module",
  "bin": {
    "wowidea": "dist/cli.js",
    "easyai": "dist/cli.js",
    "easyai-canvas": "dist/canvas-cli.js"
  },
  "files": [
    "dist",
    "skill/easyai",
    "skill/canvas-agent-operator",
    "skill/gpt-image-25-prompt",
    "skill/wowidea",
    "skills",
    "data",
    "AGENTS.md",
    "openapi",
    "docs",
    "scripts"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/canvas-cli.ts --format esm --clean --external keytar --external sharp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run resources:check && npm run typecheck && npm run build && npm test",
    "pack:check": "npm pack --dry-run",
    "package:host": "npm run build && node scripts/package-host.mjs",
    "resources:check": "node scripts/check-resources.mjs",
    "resources:lock": "node scripts/check-resources.mjs --update",
    "prepack": "node scripts/prepack.mjs",
    "package:smoke": "node scripts/smoke-package.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@easyaigc/canvas-cli": "0.5.0",
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "commander": "^14.0.0",
    "sharp": "^0.34.4"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@yao-pkg/pkg": "^6.22.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pkg": {
    "scripts": [
      "dist/*.js"
    ],
    "assets": [
      "node_modules/keytar/build/Release/*.node",
      "skill/**/*"
    ]
  }
}
